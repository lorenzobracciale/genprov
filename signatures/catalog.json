{
  "schema_version": "0.1",
  "generators": [
    {
      "id": "protoc",
      "name": "Protocol Buffers compiler (protoc)",
      "purl": "pkg:github/protocolbuffers/protobuf",
      "kind": "generator",
      "languages": ["c++", "java", "python", "go", "ruby", "javascript"],
      "signatures": [
        {
          "type": "header",
          "pattern": "Generated by the protocol buffer compiler\\.\\s+DO NOT EDIT!",
          "first_lines": 3,
          "source": "src/google/protobuf/compiler/*/*_generator.cc"
        },
        {
          "type": "header",
          "pattern": "Protobuf (?:C\\+\\+|Java|Python) Version: (?P<version>\\d+\\.\\d+(?:\\.\\d+)?)",
          "first_lines": 10,
          "captures": ["version"],
          "note": "present in protoc >= 22; absent in older output"
        },
        {
          "type": "filename",
          "pattern": "(?:_pb2\\.py|_pb2_grpc\\.py|\\.pb\\.go|\\.pb\\.cc|\\.pb\\.h|_pb\\.rb)$"
        }
      ]
    },
    {
      "id": "openapi-generator",
      "name": "OpenAPI Generator",
      "purl": "pkg:maven/org.openapitools/openapi-generator",
      "kind": "generator",
      "languages": ["java", "kotlin", "scala", "typescript", "python", "go", "csharp"],
      "signatures": [
        {
          "type": "header",
          "pattern": "NOTE: This class is auto generated by OpenAPI Generator \\(https://openapi-generator\\.tech\\)",
          "first_lines": 15,
          "source": "modules/openapi-generator/src/main/resources/*/licenseInfo.mustache"
        },
        {
          "type": "annotation",
          "pattern": "@(?:javax\\.annotation\\.|jakarta\\.annotation\\.)?Generated\\(value\\s*=\\s*\"org\\.openapitools\\.codegen\\.languages\\.(?P<language>\\w+)\"(?:,\\s*date\\s*=\\s*\"[^\"]*\")?(?:,\\s*comments\\s*=\\s*\"Generator version: (?P<version>[\\d.]+(?:-SNAPSHOT)?)\")?",
          "captures": ["language", "version"],
          "note": "the 'Generator version' comment was added in 7.x; earlier output has no version marker"
        },
        {
          "type": "filename",
          "pattern": "^\\.openapi-generator/(?:VERSION|FILES)$",
          "version_file": true,
          "note": ".openapi-generator/VERSION contains the exact version used, when the directory is committed"
        }
      ],
      "known_output_advisories": ["CVE-2021-21430"]
    },
    {
      "id": "antlr4",
      "name": "ANTLR 4",
      "purl": "pkg:maven/org.antlr/antlr4",
      "kind": "generator",
      "languages": ["java", "python", "csharp", "javascript", "go", "c++"],
      "signatures": [
        {
          "type": "header",
          "pattern": "Generated from (?P<grammar>\\S+\\.g4) by ANTLR (?P<version>\\d+\\.\\d+(?:\\.\\d+)?)",
          "first_lines": 3,
          "captures": ["grammar", "version"],
          "source": "tool/resources/org/antlr/v4/tool/templates/codegen/*/*.stg"
        },
        {
          "type": "filename",
          "pattern": "(?:Lexer|Parser|Listener|Visitor|BaseListener|BaseVisitor)\\.(?:java|py|cs|js|go|cpp|h)$",
          "requires": "header"
        }
      ]
    },
    {
      "id": "cython",
      "name": "Cython",
      "purl": "pkg:pypi/cython",
      "kind": "generator",
      "languages": ["c", "c++"],
      "signatures": [
        {
          "type": "header",
          "pattern": "/\\* Generated by Cython (?P<version>\\d+\\.\\d+(?:\\.\\d+)?(?:[abr]c?\\d+)?)",
          "first_lines": 1,
          "captures": ["version"],
          "source": "Cython/Compiler/ModuleNode.py"
        }
      ]
    },
    {
      "id": "asn1scc",
      "name": "ASN1SCC (ESA ASN.1 compiler)",
      "purl": "pkg:github/esa/asn1scc",
      "kind": "generator",
      "languages": ["c", "ada"],
      "signatures": [
        {
          "type": "include",
          "pattern": "#include\\s+\"asn1crt\\.h\"",
          "first_lines": 30,
          "note": "generated encoders include the runtime header; header comment wording varies across versions and is not used as primary marker"
        }
      ]
    },
    {
      "id": "asn1scc-runtime",
      "name": "ASN1SCC runtime (asn1crt)",
      "purl": "pkg:github/esa/asn1scc",
      "kind": "runtime",
      "generator": "asn1scc",
      "languages": ["c"],
      "signatures": [
        {
          "type": "filename",
          "pattern": "^asn1crt(?:_encoding(?:_uper|_acn|_xer)?|_core)?\\.(?:c|h)$"
        },
        {
          "type": "include_guard",
          "pattern": "#ifndef\\s+ASN1CRT_(?:H|ENCODING_H|ENCODING_UPER_H|ENCODING_ACN_H)",
          "first_lines": 20
        }
      ],
      "note": "version is not declared in the files; identify the copy by content hash (SWHID) against known releases"
    }
  ]
}
